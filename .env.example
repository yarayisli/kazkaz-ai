# Backend
APP_ENV=development
FIREBASE_PROJECT_ID=your-firebase-project-id
# Canlı sunucuda Firebase Admin servis hesabını tek satır JSON secret olarak tanımlayın.
# JSON dosyasını projeye, Docker imajına veya Git deposuna eklemeyin.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Özgün PDF/Excel arşivi için yalnız sunucunun eriştiği Firebase Storage bucket adı.
FIREBASE_STORAGE_BUCKET=your-firebase-project-id.firebasestorage.app
# Bucket yaşam döngüsü REPORT_RETENTION_DAYS ile uyumlu olarak doğrulandıktan sonra true yapın.
REPORT_STORAGE_LIFECYCLE_CONFIGURED=false
# Ayrı bir servis hesabı kullanın; yalnızca Sheets read-only kapsamı verilir.
# Kullanıcı hedef belgeyi bu hesabın client_email adresiyle Görüntüleyici olarak paylaşır.
GOOGLE_SHEETS_SERVICE_ACCOUNT_JSON=
# Logo API/NetOpenX için çözüm ortağı veya müşteri lisansı gerekir. Yalnız
# salt-okunur kapsam verin; değerleri frontend'e koymayın.
LOGO_API_BASE_URL=
LOGO_TOKEN_URL=
LOGO_CLIENT_ID=
LOGO_CLIENT_SECRET=
LOGO_COMPANY_CODE=
LOGO_READONLY_SCOPE=
LOGO_TIMEOUT_SECONDS=20
LOGO_OAUTH_GRANT_TYPE=client_credentials
LOGO_USERNAME=
LOGO_PASSWORD=
CORS_ORIGINS=http://localhost:3000
# Canlıda gerçek alan adları ve platform hostu; geliştirmede * kullanılabilir.
ALLOWED_HOSTS=*
ENFORCE_HTTPS=false
# V1: NVIDIA birincil; Groq ve Gemini sıralı yedek. Aynı veri paralel gönderilmez.
AI_PROVIDER_ORDER=nvidia,groq,gemini
NVIDIA_API_KEY=
NVIDIA_MODEL=openai/gpt-oss-20b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_TIMEOUT_SECONDS=30
NVIDIA_MAX_RETRIES=0
GROQ_API_KEY=
GEMINI_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_MODEL=gemini-2.0-flash

# Yalnızca yerel geliştirmede kullanılabilir; production ortamında etkisizdir.
KAZKAZ_AUTH_DISABLED=false
PLATFORM_ADMIN_EMAILS=

# Uygulama katmanı korumaları. Canlıda ters proxy/WAF üzerinde de sınır koyun.
MAX_REQUEST_BYTES=5242880
API_RATE_LIMIT_PER_MINUTE=120
AI_RATE_LIMIT_PER_MINUTE=20
PERFORMANCE_WINDOW_SIZE=5000
PUBLIC_PERFORMANCE_MIN_SAMPLES=30
# Dört haftalık pilotun son haftasında şirket yöneticisine devam niyeti sorulur.
PILOT_SURVEY_MIN_DAYS=21

# Canlıda varsayılan true; ödeme sağlayıcısı bağlanana kadar geliştirmede raporlama modundadır.
ENFORCE_PLAN_LIMITS=false
PAYMENT_PROVIDER=yapilandirilmadi
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=
PRO_MONTHLY_PRICE_KURUS=
REFUND_WINDOW_DAYS=30
SALES_TERMS_VERSION=
REFUND_POLICY_VERSION=
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05
FIRESTORE_BACKUP_BUCKET=
FIRESTORE_DATABASE_ID=(default)
# Ardışık iki başarılı yedek kanıtından ölçülür.
BACKUP_RPO_TARGET_HOURS=24
BACKUP_MAX_OBSERVED_INTERVAL_HOURS=
BACKUP_SCHEDULE_VERIFIED_AT=
# Ayrı ve silinebilir test projesindeki doğrulanmış tatbikattan ölçülür.
BACKUP_RTO_TARGET_SECONDS=3600
BACKUP_RESTORE_RTO_SECONDS=
DATA_RETENTION_DAYS=365
REPORT_RETENTION_DAYS=365
FIRESTORE_RULES_DEPLOYED=false
TENANT_ISOLATION_TEST_PASSED=false
FINANCIAL_METHODOLOGY_APPROVED=false
KVKK_REVIEW_APPROVED=false
BACKUP_RESTORE_TESTED_AT=
